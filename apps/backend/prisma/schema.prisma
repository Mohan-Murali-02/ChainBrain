generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scan {
  id                     String   @id @default(cuid())
  projectName            String
  uploadedAt             DateTime @default(now())

  totalPackages          Int
  vulnerablePackages     Int
  totalVulnerabilities   Int
}